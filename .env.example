# ============================================================================
# AI Capsule — Environment Variables
# ============================================================================
# Copy this file to ".env" in the project root (same folder as this file)
# and fill in the blank values. NEVER commit the real ".env" file.
#
# During local development, the server reads this file automatically
# (server/index.js loads dotenv from the project root).
# On Render / Azure, paste these same key=value pairs into the platform's
# "Environment Variables" dashboard instead of uploading a .env file.
# ============================================================================

# ---- Server -----------------------------------------------------------------
# Port the Express server listens on. Render/Azure usually inject PORT
# automatically — leave the value below for local development only.
PORT=5000

# "development" locally, "production" when deployed.
NODE_ENV=development

# The full public URL of your deployed app (no trailing slash).
# Used to build OAuth callback URLs and for cookie/CORS settings.
# Example: https://ai-capsule.onrender.com
# For local dev, leave as http://localhost:5000
APP_BASE_URL=http://localhost:5000

# ---- Application JWT ---------------------------------------------------------
# A long, random, secret string used to SIGN the application JWT that
# Express issues after a successful OAuth login. This is NOT your OAuth
# client secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bbd7c626c05f271bdde7b4a569962d7094bce50f7327b387000705a3916dd97a0d118285a9ca4924dd894fb4bbe7f4ab

# How long the application JWT / cookie stays valid.
JWT_EXPIRES_IN=7d

# ---- OAuth provider selection -------------------------------------------------
# Which provider /login uses. "github" is recommended by the assignment;
# "google" is the accepted fallback if GitHub OAuth is unavailable to you.
OAUTH_PROVIDER=github

# ---- GitHub OAuth (recommended) ----------------------------------------------
# Create at: https://github.com/settings/developers  ->  "New OAuth App"
# Homepage URL:            <APP_BASE_URL>
# Authorization callback:  <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Google OAuth (fallback, only needed if OAUTH_PROVIDER=google) -----------
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Database ------------------------------------------------------------------
# SQLite file path (relative to /server). This satisfies the assignment's
# minimum storage requirement. On Render's free tier this file lives on an
# ephemeral disk and may be wiped on redeploy/restart — see README for details.
DB_PATH=./data/capsules.db
